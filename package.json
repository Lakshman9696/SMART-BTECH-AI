{
  "name": "campus-ai-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "start:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "@supabase/supabase-js": "2.117.3",
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "10.0.6",
    "vite": "8.3.4"
  }
}
