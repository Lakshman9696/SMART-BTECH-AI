# Supabase browser settings: these are public project connection values, not secrets.
# Never put the service-role key or any AI provider key in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only AI configuration. Keep this out of VITE_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
API_PORT=8788
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

